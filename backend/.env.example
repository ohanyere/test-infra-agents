# HTTP port for the API server.
PORT=8080

# Local development PostgreSQL connection string. Do not commit real credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/infra_agents?sslmode=disable

# Runtime environment name included in structured startup logs.
ENVIRONMENT=development

# Supported values: debug, info, warn, error.
LOG_LEVEL=info

# Browser application origin used for authenticated mutation Origin checks.
APP_ORIGIN=http://localhost:3000

# Server-side session lifetime. Go duration syntax.
SESSION_TTL=168h

# Optional in development. Secure cookies are mandatory outside development.
COOKIE_SECURE=false

# Optional AI-assisted scenario authoring. Set both values to enable description
# and incident-import draft generation; leave both unset for manual authoring only.
OPENAI_API_KEY=
SCENARIO_LLM_MODEL=
# Standard-base64 encoding of exactly 32 random bytes. Never commit a real key.
AGENT_CREDENTIAL_ENCRYPTION_KEY=
# Development/testing only. Hosted environments fail closed for private addresses.
ALLOW_PRIVATE_AGENT_ENDPOINTS=false

# Optional fake/development billing provider webhook HMAC secret. Provider
# callbacks fail closed when this is unset; never commit a real secret.
BILLING_WEBHOOK_SECRET=

# MCP is served by the worker over stateless Streamable HTTP. The public URL
# must be reachable by evaluated agents and should terminate TLS in hosted use.
MCP_PUBLIC_ENDPOINT=
MCP_LISTEN_ADDRESS=:8082
